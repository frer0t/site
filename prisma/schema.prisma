
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model feebacks {
  feedback_id String   @id @default(uuid())
  feedback    String?  @default("")
  link        String?  @default("")
  initials    String
  message     String
  created_at  DateTime @default(now())
}
